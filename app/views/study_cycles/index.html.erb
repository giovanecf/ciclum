<% content_for :title, "Ciclos — Ciclum" %><div class="page-heading"><div><p class="eyebrow">SEUS PLANOS</p><h1>Ciclos de estudo</h1><p class="muted">Um ciclo ativo por vez. Alternar preserva sessões e progresso de cada ciclo.</p></div></div>
<div class="content-grid ffds-row"><section class="panel ffds-card ffds-col-12 ffds-col-lg-8"><div class="section-title"><h2>Ciclos cadastrados</h2></div><% @cycles.each do |cycle| %><article class="manage-row"><div class="manage-main"><strong><%= cycle.name %> <%= content_tag(:span, "Ativo", class: "badge ffds-badge ffds-badge-subtle-success") if cycle.active? %></strong><span>Referência: <%= cycle.weekly_reference_minutes %> min/semana</span></div><div class="actions"><%= button_to "Ativar", activate_study_cycle_path(cycle), method: :patch, class: "button ffds-btn ffds-btn-sm ffds-btn-primary" unless cycle.active? %><%= button_to "Salvar", study_cycle_path(cycle), method: :patch, params: {study_cycle: {name: cycle.name, weekly_reference_minutes: cycle.weekly_reference_minutes}}, class: "button ffds-btn ffds-btn-sm ffds-btn-secondary" %><%= button_to "Excluir", study_cycle_path(cycle), method: :delete, data: {turbo_confirm: "Excluir ciclo e seus registros?"}, class: "button ffds-btn ffds-btn-sm ffds-btn-danger" unless cycle.seed_key.present? %></div></article>
<%= form_with model: cycle, class: "inline-edit" do |f| %><%= f.text_field :name, class: "ffds-form-control", aria: {label: "Nome do ciclo"} %><%= f.number_field :weekly_reference_minutes, class: "ffds-form-control", min: 1, aria: {label: "Referência semanal em minutos"} %><%= f.submit "Atualizar", class: "button ffds-btn ffds-btn-sm ffds-btn-secondary" %><% end %><% end %></section>
<aside class="panel ffds-card form-panel ffds-col-12 ffds-col-lg-4"><h2>Novo ciclo</h2><%= form_with model: @cycle do |f| %><% if @cycle.errors.any? %><div class="form-errors ffds-alert ffds-alert-danger"><%= @cycle.errors.full_messages.to_sentence %></div><% end %><div class="field"><%= f.label :name, "Nome" %><%= f.text_field :name, class: "ffds-form-control", required: true %></div><div class="field"><%= f.label :weekly_reference_minutes, "Referência semanal (minutos)" %><%= f.number_field :weekly_reference_minutes, class: "ffds-form-control", min: 1, required: true %></div><div class="form-actions"><%= f.submit "Criar ciclo", class: "button ffds-btn ffds-btn-primary" %></div><% end %></aside></div>
