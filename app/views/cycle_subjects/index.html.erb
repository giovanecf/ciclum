<% content_for :title, "Disciplinas — Ciclum" %>
<div class="page-heading"><div><p class="eyebrow">CICLO: <%= active_cycle.name.upcase %></p><h1>Disciplinas</h1><p class="muted">Sugestões são orientativas; só os minutos práticos controlam a rotação.</p></div></div>
<div class="content-grid ffds-row"><section class="panel ffds-card ffds-col-12 ffds-col-lg-8"><div class="section-title"><h2>Suas disciplinas</h2></div>
  <% if @subjects.empty? %><p class="muted">Nenhuma disciplina ainda. Você pode começar só pelo nome.</p><% end %>
  <% @subjects.each do |subject| %><article class="manage-row <%= 'archived' if subject.archived_at? %>"><div class="manage-main"><strong><%= subject.name %></strong><span><%= subject.archived_at? ? "Arquivada" : subject.configured_minutes ? "#{subject.configured_minutes} min práticos" : "Sem meta prática" %></span><small>Sugestão: <%= active_cycle.suggested_minutes(subject) || "indisponível — informe os dados da prova" %><%= " min" if active_cycle.suggested_minutes(subject) %> · Participação individual não é normalizada</small></div>
  <div class="actions"><%= link_to "Editar", edit_cycle_subject_path(subject), class: "text-link" %><%= button_to(subject.archived_at? ? "Reativar" : "Arquivar", archive_cycle_subject_path(subject), method: :patch, class: "button ffds-btn ffds-btn-sm ffds-btn-secondary")  %><% if (suggestion = active_cycle.suggested_minutes(subject)) %><%= button_to "Aplicar #{suggestion} min", apply_suggestion_cycle_subject_path(subject), method: :patch, class: "button ffds-btn ffds-btn-sm ffds-btn-outline-primary" %><% end %><%= button_to "↑", move_up_cycle_subject_path(subject), method: :patch, class: "button ffds-btn ffds-btn-sm ffds-btn-secondary" unless subject.archived_at? %><%= button_to "↓", move_down_cycle_subject_path(subject), method: :patch, class: "button ffds-btn ffds-btn-sm ffds-btn-secondary" unless subject.archived_at? %></div></article><% end %>
</section>
<aside class="panel ffds-card form-panel ffds-col-12 ffds-col-lg-4"><h2>Adicionar disciplina</h2><p class="muted">O nome é suficiente para começar. Você configura os detalhes depois.</p>
<%= form_with model: @subject, url: cycle_subjects_path do |f| %><%= render "form_fields", f: f %><div class="form-actions"><%= f.submit "Adicionar disciplina", class: "button ffds-btn ffds-btn-primary" %></div><% end %></aside></div>
