<% content_for :title, "Editar disciplina — Ciclum" %><div class="narrow"><div class="page-heading"><div><p class="eyebrow">DISCIPLINAS</p><h1>Editar disciplina</h1></div></div><section class="panel ffds-card form-panel"><%= form_with model: @subject do |f| %><%= render "form_fields", f: f %><div class="form-actions"><%= f.submit "Salvar alterações", class: "button ffds-btn ffds-btn-primary" %><%= link_to "Cancelar", cycle_subjects_path, class: "button ffds-btn ffds-btn-secondary" %></div><% end %><p class="hint">Sugestão: <%= active_cycle.suggested_minutes(@subject) || "indisponível: informe os dados da prova" %></p></section></div>
