<% content_for :title, "Criar conta — Ciclum" %>
<div class="narrow auth-card">
  <div class="page-heading"><div><p class="eyebrow">SEU CICLO DE ESTUDOS</p><h1>Criar conta</h1><p class="muted">Seus ciclos, disciplinas e sessões ficam associados à sua conta.</p></div></div>
  <section class="panel ffds-card form-panel">
    <% if @user.errors.any? %>
      <div class="form-errors ffds-alert ffds-alert-danger"><%= @user.errors.full_messages.to_sentence %></div>
    <% end %>
    <%= form_with model: @user, url: signup_path do |f| %>
      <div class="field"><%= f.label :full_name, "Nome (opcional)" %><%= f.text_field :full_name, autocomplete: "name", maxlength: 150, class: "ffds-form-control" %></div>
      <div class="field"><%= f.label :email, "E-mail" %><%= f.email_field :email, required: true, autofocus: true, autocomplete: "email", class: "ffds-form-control" %></div>
      <div class="field"><%= f.label :password, "Senha" %><%= f.password_field :password, required: true, minlength: 8, maxlength: 72, autocomplete: "new-password", class: "ffds-form-control" %><small class="hint">Use pelo menos 8 caracteres.</small></div>
      <div class="field"><%= f.label :password_confirmation, "Confirme a senha" %><%= f.password_field :password_confirmation, required: true, minlength: 8, maxlength: 72, autocomplete: "new-password", class: "ffds-form-control" %></div>
      <div class="form-actions"><%= f.submit "Criar conta", class: "button ffds-btn ffds-btn-primary" %></div>
    <% end %>
    <p class="auth-switch">Já tem conta? <%= link_to "Entrar", login_path, class: "text-link" %></p>
  </section>
</div>
