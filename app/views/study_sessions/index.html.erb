<% content_for :title, "Sessões — Ciclum" %><div class="page-heading"><div><p class="eyebrow">REGISTROS DO CICLO ATIVO</p><h1>Sessões de estudo</h1><p class="muted">A data mostra quando você estudou; a ordem do motor segue o lançamento original.</p></div><%= link_to "+ Adicionar sessão", new_study_session_path, class: "button ffds-btn ffds-btn-primary" %></div>
<section class="panel ffds-card table-panel"><% if @sessions.empty? %><div class="empty-inline"><p>Nenhuma sessão registrada ainda.</p><%= link_to "Registrar primeira sessão", new_study_session_path, class: "text-link" %></div><% else %><div class="table-scroll"><table><thead><tr><th>Data do estudo</th><th>Disciplina</th><th>Minutos</th><th></th></tr></thead><tbody><% @sessions.each do |session| %><tr><td><%= l(session.studied_on, format: :long) rescue session.studied_on.strftime("%d/%m/%Y") %></td><td><%= session.cycle_subject.name %></td><td><%= session.minutes %> min</td><td class="table-actions"><%= link_to "Editar", edit_study_session_path(session), class: "text-link" %><%= button_to "Excluir", study_session_path(session), method: :delete, data: { turbo_confirm: "Excluir esta sessão? O ciclo será recalculado." }, class: "button ffds-btn ffds-btn-sm ffds-btn-danger" %></td></tr><% end %></tbody></table></div><% end %></section>
