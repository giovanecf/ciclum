<% content_for :title, "Entrar — Ciclum" %>
<div class="narrow auth-card">
  <div class="page-heading"><div><p class="eyebrow">SEU CICLO DE ESTUDOS</p><h1>Entrar no Ciclum</h1><p class="muted">Acesse seus ciclos e registros de estudo.</p></div></div>
  <section class="panel ffds-card auth-about" aria-labelledby="auth-about-title">
    <p class="eyebrow">ESTUDO CONTÍNUO, NO SEU RITMO</p>
    <h2 id="auth-about-title">O que é o Ciclum?</h2>
    <p>Organize disciplinas em ciclos contínuos, registre suas sessões e acompanhe o tempo estudado. A rotação segue a ordem dos lançamentos e continua de uma semana para outra.</p>
    <p class="auth-about-credit">O ciclo contínuo tem referências como William Douglas e foi amplamente divulgado por Alexandre Meirelles.</p>
    <%= link_to "Conheça como funciona", about_path, class: "text-link" %>
  </section>
  <section class="panel ffds-card form-panel">
    <%= form_with url: login_path, method: :post do |f| %>
      <div class="field"><%= f.label :email, "E-mail" %><%= f.email_field :email, required: true, autofocus: true, autocomplete: "email", class: "ffds-form-control" %></div>
      <div class="field"><%= f.label :password, "Senha" %><%= f.password_field :password, required: true, autocomplete: "current-password", class: "ffds-form-control" %></div>
      <div class="form-actions"><%= f.submit "Entrar", class: "button ffds-btn ffds-btn-primary" %></div>
    <% end %>
    <div class="auth-divider"><span>ou</span></div>
    <%= button_to "Continuar como visitante", guest_session_path, method: :post, class: "button ffds-btn ffds-btn-secondary guest-button" %>
    <p class="muted guest-note">Os ciclos ficam salvos temporariamente no servidor e expiram após 24 horas sem atividade. Crie uma conta para mantê-los.</p>
    <p class="auth-switch">Ainda não tem conta? <%= link_to "Criar conta", signup_path, class: "text-link" %></p>
  </section>
</div>
